{
  "expo": {
    "name": "LERM",
    "slug": "lerm",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/lerm_app.png",
    "scheme": "lermdemo",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.esehatmeditechltd.lerm",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.esehatmeditechltd.lerm",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/lerm_app.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "usesCleartextTraffic": true
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/lerm_app.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/lerm_app.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "9ef3dba5-6dfd-47d9-b1ce-ecafd192c88b"
      }
    },
    "owner": "esehat-meditech-ltd"
  }
}